PORT=5000
NODE_ENV=development
SITE_URL=http://localhost:5000

# Local example. In production, use the mongodb+srv URI from MongoDB Atlas.
MONGODB_URI=mongodb://127.0.0.1:27017
# This overrides any database name embedded in MONGODB_URI and keeps this site isolated.
MONGODB_DB_NAME=landline_properties
MONGODB_MAX_POOL_SIZE=10
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_AUTO_INDEX=true

JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=8h

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5000,http://localhost:5500,http://127.0.0.1:5500

# Used for the initial admin account created by `npm run seed:admin`
SEED_ADMIN_EMAIL=admin@landline.com
SEED_ADMIN_PASSWORD=change_me_before_running_seed
SEED_ADMIN_NAME=Admin
